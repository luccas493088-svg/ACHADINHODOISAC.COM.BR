# Copie este arquivo para .env e preencha os valores.
# NUNCA versione o arquivo .env real.

# --- Banco de dados ---
DATABASE_URL=postgresql://user:password@localhost:5432/isac_achadinhos

# --- Segurança ---
# Gere um valor longo e aleatorio, ex: openssl rand -hex 32
JWT_SECRET=change-me-long-random-string

# --- Cache / rate limiting ---
REDIS_URL=redis://localhost:6379/0

# --- Integracoes oficiais (Fase 6: builders; live exige AFFILIATE_LIVE=1) ---
AMAZON_ACCESS_KEY_ID=
AMAZON_SECRET_ACCESS_KEY=
AMAZON_PARTNER_TAG=
MERCADOLIVRE_APP_ID=
MERCADOLIVRE_CLIENT_SECRET=
MONETIZZE_API_KEY=

# --- Webhooks de conversão (Fase 6: um segredo por rede, HMAC-SHA256) ---
AMAZON_WEBHOOK_SECRET=
MERCADOLIVRE_WEBHOOK_SECRET=
MONETIZZE_WEBHOOK_SECRET=
TIKTOK_WEBHOOK_SECRET=

# --- Agendador + jobs (Fase 6/8: tudo DESLIGADO por padrão = dry-run) ---
# AFFILIATE_LIVE=1 libera chamadas externas (nunca ligue sem credenciais reais)
AFFILIATE_LIVE=0
ENABLE_SCHEDULER=0
SYNC_INTERVAL_MINUTES=60

# --- Conectores de loja p/ cadastro automático futuro (Fase 8, dry-run) ---
TIKTOK_SHOP_API_KEY=
TIKTOK_SHOP_API_SECRET=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
